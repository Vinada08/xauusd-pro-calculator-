# Copy this file to .env and fill it in. NEVER commit .env.

# --- Claude API (create at https://console.anthropic.com -> API Keys) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- MT5 login (leave blank to use the account already logged in to the terminal) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=          # e.g. C:\Program Files\MetaTrader 5\terminal64.exe

# --- Trading ---
SYMBOL=XAUUSD               # some brokers use XAUUSDm, GOLD, XAUUSD.r ...
TIMEFRAME=M15               # M1 M5 M15 M30 H1 H4 D1
RISK_PERCENT=1.0            # % of balance risked per trade
MIN_RR=1.5                  # minimum reward:risk Claude's TP must give
MIN_SL_DOLLARS=2.0          # SL distance limits, in gold price dollars
MAX_SL_DOLLARS=25.0
MAX_SPREAD_DOLLARS=0.60     # skip trading if spread is wider than this
MIN_CONFIDENCE=0.65         # ignore Claude ideas below this confidence (0-1)
MAX_OPEN_POSITIONS=1
MAX_DAILY_LOSS_PERCENT=3.0  # stop opening trades after this daily drawdown
CHECK_EVERY_SECONDS=60      # how often to look for a newly closed candle
MAGIC_NUMBER=880808

# --- Safety switches ---
ALLOW_LIVE_ACCOUNT=false    # must be true to trade a REAL (non-demo) account
AUTO_CONFIRM=false          # false = you type "y" before every order
DRY_RUN=false               # true = analyse and log only, never send orders

# --- Claude ---
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium        # low | medium | high
